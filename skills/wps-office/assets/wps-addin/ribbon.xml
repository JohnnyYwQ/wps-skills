<?xml version="1.0" encoding="UTF-8"?>
<!-- Input: 功能区 UI 定义 -->
<!-- Output: WPS 功能区按钮布局 -->
<!-- Pos: 跨平台统一 WPS Add-in 功能区配置。一旦我被修改，请更新我的头部注释，以及所属文件夹的md。 -->
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnAddinLoad">
  <ribbon startFromScratch="false">
    <tabs>
      <tab id="wpsOfficeSkillTab" label="WPS Office Skill" insertAfterMso="TabView">
        <group id="wpsOfficeSkillConnectionGroup" label="连接与状态">
          <button id="wpsOfficeSkillStatusButton"
                  label="查看状态"
                  size="large"
                  onAction="OnStatusClick"
                  imageMso="Info"
                  screentip="查看 WPS Office Skill 状态"
                  supertip="查看 Add-in 的轮询状态以及本机 Python Runner 地址。"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
